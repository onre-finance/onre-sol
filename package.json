{
  "name": "onre-app",
  "description": "OnRe application to purchase, schedule and redeem tokens",
  "private": true,
  "version": "0.0.9",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "anchor-build": "anchor build",
    "test": "anchor build && cargo test -p onreapp",
    "script:mainnet-prod": "NETWORK=mainnet-prod tsx",
    "script:mainnet-test": "NETWORK=mainnet-test tsx",
    "script:mainnet-dev": "NETWORK=mainnet-dev tsx",
    "script:devnet-test": "NETWORK=devnet-test tsx",
    "script:devnet-dev": "NETWORK=devnet-dev tsx",
    "surfpool:regression": "tsx scripts/surfpool-regression/run.ts",
    "surfpool:setup": "tsx scripts/surfpool-regression/setup-upgrade.ts",
    "cli": "tsx scripts/cli/index.ts",
    "ui": "vite --config scripts/ui/vite.config.ts",
    "ui:build": "vite build --config scripts/ui/vite.config.ts",
    "docker:surfpool": "docker compose -f docker-compose.surfpool.yml up --build"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.2",
    "@inquirer/prompts": "^8.7.5",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@noble/ed25519": "^3.2.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "date-fns": "^4.4.0",
    "ethers": "^6.17.0",
    "jotai": "^3.0.1",
    "ora": "^10.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.6",
    "@types/node-fetch": "^2.6.13",
    "dotenv": "^18.0.9",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
