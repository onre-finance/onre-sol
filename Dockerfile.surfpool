FROM solanafoundation/anchor:v1.0.2

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y \
    bash \
    ca-certificates \
    curl \
    git \
    libssl-dev \
    pkg-config \
    unzip \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.nvm/versions/node/v22.13.0/bin:/root/.local/bin:${PATH}"

RUN rustup toolchain install 1.99.1 --profile minimal && rustup default 1.99.1
RUN cargo install --git https://github.com/otter-sec/anchor --tag v1.2.2 anchor-cli --locked --force && \
    sh -c "$(curl -sSfL https://release.anza.xyz/v4.1.2/install)"
RUN source /root/.nvm/nvm.sh && \
    nvm install 22.13.0 && \
    nvm alias default 22.13.0 && \
    npm install -g pnpm@12.16.1 && \
    node --version
RUN curl -fsSL https://run.surfpool.run/ | bash && \
    SURFPOOL_BIN="$(command -v surfpool || find /root -type f -name surfpool | head -n 1)" && \
    test -n "$SURFPOOL_BIN" && \
    install -m 0755 "$SURFPOOL_BIN" /usr/local/bin/surfpool && \
    surfpool --version

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile --config.optional=true

COPY . .
RUN anchor build --arch v3
RUN chmod +x scripts/docker/surfpool-entrypoint.sh

EXPOSE 5173 8899 8900 18488

CMD ["scripts/docker/surfpool-entrypoint.sh"]
